rules_version = '2';

// Deploy: npm run firebase:deploy-storage
// Upload files to Storage → assets/ (same filenames as before on S3)

service firebase.storage {
  match /b/{bucket}/o {
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == "asadmulla241097@gmail.com" ||
          request.auth.token.email.lower() == "asadmulla2407@gmail.com"
        ))
      );
    }
  }
}
