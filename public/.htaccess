<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical domain: https://tech-giant.in (redirect www to apex)
  RewriteCond %{HTTP_HOST} ^www\.tech-giant\.in [NC]
  RewriteRule ^(.*)$ https://tech-giant.in/$1 [R=301,L]

  RewriteRule ^index\.html$ - [L]

  # Google Search Console verification file — never rewrite to SPA
  RewriteRule ^google[a-z0-9]+\.html$ - [L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
