# Copy to .env.local and fill in. Vite exposes only vars prefixed with VITE_.

# Firebase (required for auth / Firestore)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Comma-separated admin emails (client UI). When deploying firestore.rules, mirror admins there or use Auth custom claims { "admin": true }.
# Example: VITE_ADMIN_EMAILS=you@example.com,other@example.com
VITE_ADMIN_EMAILS=

# Set to "true" in production to require verified email before dashboard access
VITE_REQUIRE_EMAIL_VERIFICATION=false

# Optional: EmailJS / Web3Forms (see src/services/emailService.ts)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: Storage folder for public media (default: assets)
VITE_MEDIA_PREFIX=assets

# Optional: primary inbox for admin notifications (defaults to first admin email)
VITE_ADMIN_NOTIFICATION_EMAIL=

# Canonical site URL for SEO (canonical tags, sitemap, structured data)
VITE_SITE_URL=https://tech-giant.in
